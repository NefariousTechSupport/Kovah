<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
	  <ProjectReference Include="..\Sapphire\Sapphire.csproj" />
		<ProjectReference Include="../Kovah.CodeGen/Kovah.CodeGen.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>CS0169</NoWarn> <!-- unused private class field, disabled due to autogenerated code -->
		<!-- Set this to true to debug the Kovah.CodeGen produced code -->
		<EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
	</PropertyGroup>
</Project>
